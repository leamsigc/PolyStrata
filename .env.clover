# Clover-35B-A3B-Preview, APEX-I-NANOPLUS.
# 128K context, 3 slots: all experts stay in VRAM by setup's arithmetic (~3.7 GB spare).
# Text only. Clover's block guessing is off in PolyStrata; it was slower where measured.
# API_KEY is set in Coolify, not here.
FAMILY=clover
MODEL=APEX-I-NANOPLUS
CONTEXT=131072
PARALLEL=3
CONVERSATION_CACHE_MIB=8192
CONVERSATION_CACHE_SLOTS=8
VISION=no
LOW_RAM=auto
HOST=0.0.0.0
PORT=8080
REINSTALL=0
