# Qwen3.6-35B-A3B, UD-Q2_K_XL (the current install).
# 128K context, 3 slots: ~0.9 GB VRAM spare by setup's arithmetic; all experts stay in VRAM.
# CPU image encoder: no VRAM taken from the experts; pictures take ~1-2 s (measured on other machines).
# API_KEY is set in Coolify, not here.
FAMILY=qwen36
MODEL=UD-Q2_K_XL
CONTEXT=131072
PARALLEL=3
CONVERSATION_CACHE_MIB=8192
CONVERSATION_CACHE_SLOTS=8
VISION=cpu
LOW_RAM=auto
HOST=0.0.0.0
PORT=8080
REINSTALL=0
