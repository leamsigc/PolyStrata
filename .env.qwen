# Qwen3.8-Flash-Next (original), IQ2_XS -- primary/router model.
# 128K context, 2 slots: ~61.2 GB of 63 GB RAM with the 6 GB cache (setup's arithmetic).
# CPU image encoder: no VRAM taken from the experts; pictures take ~3-13 s (measured on other machines).
# For model switching, add "switch_on_request": true to /data/config/strata-iq2_xs.json
# once, then restart. It is a config key, not an env var.
# API_KEY is set in Coolify, not here.
FAMILY=qwen
MODEL=IQ2_XS
CONTEXT=131072
PARALLEL=2
CONVERSATION_CACHE_MIB=6144
CONVERSATION_CACHE_SLOTS=8
VISION=cpu
LOW_RAM=auto
HOST=0.0.0.0
PORT=8080
REINSTALL=0
