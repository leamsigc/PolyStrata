# Qwen3.8-Flash-Next Coder, IQ1_M -- 3 slots as requested.
# 128K context, 3 slots: ~48.8 GB of 63 GB RAM with the 6 GB cache; ~68% of its
# experts stay in VRAM (setup's arithmetic). Half the experts, so code-only.
# CPU image encoder: no VRAM taken from the experts; pictures take ~3-13 s (measured on other machines).
# API_KEY is set in Coolify, not here.
FAMILY=coder
MODEL=IQ1_M
CONTEXT=131072
PARALLEL=3
CONVERSATION_CACHE_MIB=6144
CONVERSATION_CACHE_SLOTS=8
VISION=cpu
LOW_RAM=auto
HOST=0.0.0.0
PORT=8080
REINSTALL=0
